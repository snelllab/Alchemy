grep ":PA  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":PU  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":AM  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":CM  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":CF  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":GE  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":NB  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":TC  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":ND  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":PM  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":TM  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":PO  " *_stats.out | cut -c -100  >> Other_metal_data
