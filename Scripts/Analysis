grep ":SG  " *_stats.out | cut -c -100  >> Other_metal_data
#
# Add function to remove lines that have chain K, common ligands, 
# or carbon alpha (CA) and are mistakenly counted
#
echo "Removing most errors - Chain K, carbon alpha Ca etc."
#
sed -i '/:ALA/d' K_Data
sed -i '/:CYS/d' K_Data
sed -i '/:ASP/d' K_Data
sed -i '/:GLU/d' K_Data
sed -i '/:PHE/d' K_Data
sed -i '/:GLY/d' K_Data
sed -i '/:HIS/d' K_Data
sed -i '/:ILE/d' K_Data
sed -i '/:LYS/d' K_Data
sed -i '/:LEU/d' K_Data
sed -i '/:MET/d' K_Data
sed -i '/:ASN/d' K_Data
sed -i '/:PRO/d' K_Data
sed -i '/:GLN/d' K_Data
sed -i '/:ARG/d' K_Data
sed -i '/:SER/d' K_Data
sed -i '/:THR/d' K_Data
sed -i '/:VAL/d' K_Data
sed -i '/:TRP/d' K_Data
sed -i '/:TYR/d' K_Data
sed -i '/:NAG/d' K_Data
sed -i '/:DA/d' K_Data
sed -i '/:DC/d' K_Data
sed -i '/:DG/d' K_Data
sed -i '/:DT/d' K_Data
sed -i '/:CA/d' K_Data
#
sed -i '/:ALA/d' CA_Data
sed -i '/:CYS/d' CA_Data
sed -i '/:ASP/d' CA_Data
sed -i '/:GLU/d' CA_Data
sed -i '/:PHE/d' CA_Data
sed -i '/:GLY/d' CA_Data
sed -i '/:HIS/d' CA_Data
sed -i '/:ILE/d' CA_Data
sed -i '/:LYS/d' CA_Data
sed -i '/:LEU/d' CA_Data
sed -i '/:MET/d' CA_Data
sed -i '/:ASN/d' CA_Data
sed -i '/:PRO/d' CA_Data
sed -i '/:GLN/d' CA_Data
sed -i '/:ARG/d' CA_Data
sed -i '/:SER/d' CA_Data
sed -i '/:THR/d' CA_Data
sed -i '/:VAL/d' CA_Data
sed -i '/:TRP/d' CA_Data
sed -i '/:TYR/d' CA_Data
sed -i '/:NAG/d' CA_Data
sed -i '/:DA/d' CA_Data
sed -i '/:DC/d' CA_Data
sed -i '/:DG/d' CA_Data
sed -i '/:DT/d' CA_Data
#
# Write out composite common metal data
#
cat NA_Data MG_Data K_Data CA_Data MN_Data FE_Data CO_Data NI_Data CU_Data ZN_Data > Metal_data_difference
#
Produce file sorted on highest absolute sigma first
#
sort -r -h -k 13 Metal_Data_difference > Metal_data_difference_sorted
#
# Write out detail on number of metals found
#
echo ""
echo "Number of Na ions: $(wc -l < NA_data)"
echo "Number of Mg ions: $(wc -l < MG_Data)"
echo "Number of K  ions: $(wc -l < K_Data)"
echo "Number of Ca ions: $(wc -l < CA_Data)"
echo "Number of Mn ions: $(wc -l < MN_Data)"
echo "Number of Fe ions: $(wc -l < FE_Data)"
echo "Number of Co ions: $(wc -l < CO_Data)"
echo "Number of Ni ions: $(wc -l < NI_Data)"
echo "Number of Cu ions: $(wc -l < CU_Data)"
echo "Number of Zn ions: $(wc -l < ZN_Data)"
#
echo ""
echo "Number of Se residues: $(wc -l < MSE_Data)"
echo ""
echo "Total number of common ions (less Se): $(wc -l < Metal_data_difference)"
echo ""
#
echo "Number of other metal ions: $(wc -l <  Other_metal_data)"
#
# Perform a similar analysis on any anomalous data
#
echo ""
echo "Anomalous data for Na, Mg, K, Ca, Mn, Fe, Co, Ni, Cu, and Zn."
#
grep ":NA  " *_stats_am.out | cut -c -102  > NA_am_Data
grep ":MG  " *_stats_am.out | cut -c -102  > MG_am_Data
grep ":K   " *_stats_am.out | cut -c -102  > K_am_Data
grep ":CA  " *_stats_am.out | cut -c -102  > CA_am_Data
grep ":MN  " *_stats_am.out | cut -c -102  > MN_am_Data
grep ":FE  " *_stats_am.out | cut -c -102  > FE_am_Data
grep ":CO  " *_stats_am.out | cut -c -102  > CO_am_Data
grep ":NI  " *_stats_am.out | cut -c -102  > NI_am_Data
grep ":CU  " *_stats_am.out | cut -c -102  > CU_am_Data
grep ":ZN  " *_stats_am.out | cut -c -102  > ZN_am_Data
#
grep "MSE " *_stats_am.out | cut -c -102  > MSE_am_Data
#
# Again add function to remove lines that have chain K or Carbon Alpha (CA) and are mistakenly counted
#
sed -i '/:ALA/d' K_am_Data
sed -i '/:CYS/d' K_am_Data
sed -i '/:ASP/d' K_am_Data
sed -i '/:GLU/d' K_am_Data
sed -i '/:PHE/d' K_am_Data
sed -i '/:GLY/d' K_am_Data
sed -i '/:HIS/d' K_am_Data
sed -i '/:ILE/d' K_am_Data
sed -i '/:LYS/d' K_am_Data
sed -i '/:LEU/d' K_am_Data
sed -i '/:MET/d' K_am_Data
sed -i '/:ASN/d' K_am_Data
sed -i '/:PRO/d' K_am_Data
sed -i '/:GLN/d' K_am_Data
sed -i '/:ARG/d' K_am_Data
sed -i '/:SER/d' K_am_Data
sed -i '/:THR/d' K_am_Data
sed -i '/:VAL/d' K_am_Data
sed -i '/:TRP/d' K_am_Data
sed -i '/:TYR/d' K_am_Data
sed -i '/:NAG/d' K_am_Data
sed -i '/:DA/d' K_am_Data
sed -i '/:DC/d' K_am_Data
sed -i '/:DG/d' K_am_Data
sed -i '/:DT/d' K_am_Data
sed -i '/:CA/d' K_am_Data
#
sed -i '/:ALA/d' CA_am_Data
sed -i '/:CYS/d' CA_am_Data
sed -i '/:ASP/d' CA_am_Data
sed -i '/:GLU/d' CA_am_Data
sed -i '/:PHE/d' CA_am_Data
sed -i '/:GLY/d' CA_am_Data
sed -i '/:HIS/d' CA_am_Data
sed -i '/:ILE/d' CA_am_Data
sed -i '/:LYS/d' CA_am_Data
sed -i '/:LEU/d' CA_am_Data
sed -i '/:MET/d' CA_am_Data
sed -i '/:ASN/d' CA_am_Data
sed -i '/:PRO/d' CA_am_Data
sed -i '/:GLN/d' CA_am_Data
sed -i '/:ARG/d' CA_am_Data
sed -i '/:SER/d' CA_am_Data
sed -i '/:THR/d' CA_am_Data
sed -i '/:VAL/d' CA_am_Data
sed -i '/:TRP/d' CA_am_Data
sed -i '/:TYR/d' CA_am_Data
sed -i '/:NAG/d' CA_am_Data
sed -i '/:DA/d' CA_am_Data
sed -i '/:DC/d' CA_am_Data
sed -i '/:DG/d' CA_am_Data
sed -i '/:DT/d' CA_am_Data
#
cat NA_am_Data MG_am_Data K_am_Data CA_am_Data MN_am_Data FE_am_Data CO_am_Data NI_am_Data CU_am_Data ZN_am_Data > Metal_Data_anomalous
#
# Write out detail on number of metals found
#
echo ""
echo "Number of Na ions: $(wc -l < NA_am_data)"
echo "Number of Mg ions: $(wc -l < MG_am_Data)"
echo "Number of K  ions: $(wc -l < K_am_Data)"
echo "Number of Ca ions: $(wc -l < CA_am_Data)"
echo "Number of Mn ions: $(wc -l < MN_am_Data)"
echo "Number of Fe ions: $(wc -l < FE_am_Data)"
echo "Number of Co ions: $(wc -l < CO_am_Data)"
echo "Number of Ni ions: $(wc -l < NI_am_Data)"
echo "Number of Cu ions: $(wc -l < CU_am_Data)"
