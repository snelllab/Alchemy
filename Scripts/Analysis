grep ":LR  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":TI  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":RB  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":AG  " *_stats.out | cut -c -100  >> Other_metal_data
