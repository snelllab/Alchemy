grep ":RU  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":V  "  *_stats.out | cut -c -100  >> Other_metal_data
grep ":SR  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":CS  " *_stats.out | cut -c -100  >> Other_metal_data
