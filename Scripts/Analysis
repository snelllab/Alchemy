grep ":GA  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":LA  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":SN  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":SB  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":CE  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":ZR  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":ER  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":TH  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":TI  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":IN  " *_stats.out | cut -c -100  >> Other_metal_data
