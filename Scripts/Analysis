#!/bin/bash
#
# Analysis
#
# Version 11/10/2021
#
# Analysis of Alchemy output
#
# Updates
#
#
echo ""
echo "****************************************************************************"
echo "Analysis 11/10/2021 - Script to analyze Alchemy output and prepare for plots"
echo "****************************************************************************"
echo ""
#
# Simple script to extract metal data from Alchemy files
#
DIRECTORY=($pwd)
#
echo "Starting with Na, Mg, K, Ca, Mn, Fe, Co, Ni, Cu, and Zn."
#
grep "NA  " *_stats.out | cut -c -100  > NA_data
grep "MG  " *_stats.out | cut -c -100  > MG_Data
grep "K   " *_stats.out | cut -c -100  > K_Data
grep "CA  " *_stats.out | cut -c -100  > CA_Data
grep "MN  " *_stats.out | cut -c -100  > MN_Data
grep "FE  " *_stats.out | cut -c -100  > FE_Data
grep "CO  " *_stats.out | cut -c -100  > CO_Data
grep "NI  " *_stats.out | cut -c -100  > NI_Data
grep "CU  " *_stats.out | cut -c -100  > CU_Data
grep "ZN  " *_stats.out | cut -c -100  > ZN_Data
#
echo "Searching for MSE"
#
grep "MSE " *_stats.out | cut -c -100  > MSE_Data
#
# Write uncommon metals to different file
# 
# Start file first then add additional metals to it
#
echo "Searching for other uncommon metals"
grep ":CD  " *_stats.out | cut -c -100  >  Other_metal_data
grep ":HG  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":PT  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":MO  " *_stats.out | cut -c -100  >> Other_metal_data 
grep ":AL  " *_stats.out | cut -c -100  >> Other_metal_data
grep ":BE  " *_stats.out | cut -c -100  >> Other_metal_data
